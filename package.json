{
  "name": "lunar-shadow-lab",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "terrain": "node scripts/build-terrain.mjs",
    "science:horizons": "node scripts/compute-horizons.mjs",
    "science:ephemeris": "node scripts/fetch-horizons.mjs",
    "science": "npm run science:horizons && npm run science:ephemeris"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "geotiff": "3.0.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
