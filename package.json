{
  "name": "lunar-shadow-lab",
  "version": "1.0.0",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "terrain": "node scripts/build-terrain.mjs",
    "terrain:global-ldem": "node scripts/build-global-ldem.mjs",
    "science:horizons": "node scripts/compute-horizons.mjs",
    "science:ephemeris": "node scripts/fetch-horizons.mjs",
    "science:search": "node scripts/precompute-search-grid.mjs",
    "science": "npm run science:horizons && npm run science:ephemeris && npm run science:search && npm run science:solar",
    "test": "node scripts/test-solar.mjs",
    "science:solar": "python scripts/fetch-solar-ephemeris.py"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "geotiff": "3.0.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
